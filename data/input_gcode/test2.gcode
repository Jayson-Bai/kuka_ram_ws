; ======================================================
; 单层 150x150 方形测试（包含常用指令）
; 说明：仅一层打印，Z 固定 0.20
; ======================================================

M140 S60            ; 热床 60C
M104 T0 S200        ; T0 喷头 200C
M104 T1 S205        ; T1 喷头 205C
M190 S60            ; 等热床
M109 T0 S200        ; 等 T0
M109 T1 S205        ; 等 T1

G21                 ; mm
G90                 ; 绝对坐标
M82                 ; 挤出绝对模式
G28                 ; 回零（当前解析忽略）
G29                 ; 调平（当前解析忽略）

M106 S128           ; 中速风扇

; ======================================================
; 使用 T0 打印单层正方形
; ======================================================
T0
G92 E0
G1 Z0.20 F600

; prime line
G1 X10 Y10 Z0.20 A0 B0 C0 F600
G1 E0.8 F600
G1 X10 Y60 Z0.20 A0 B0 C0 E2.8 F600
G1 E2.4 F600
G92 E0

; 150x150 外轮廓（单层）
G1 X10 Y10 Z0.20 A0 B0 C0 F600
G1 E0.5 F600
G1 X160 Y10 Z0.20 A0 B0 C0 E5.5 F600
G1 X160 Y160 Z0.20 A0 B0 C0 E10.5 F600
G1 X10 Y160 Z0.20 A0 B0 C0 E15.5 F600
G1 X10 Y10 Z0.20 A0 B0 C0 E20.5 F600

; 结束前回抽
G1 E20.0 F600

